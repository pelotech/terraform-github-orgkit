{
  extends: [
    ":semanticCommits",
    "config:recommended",
    'helpers:pinGitHubActionDigests'
  ],
  dependencyDashboard: true,
  "pre-commit": {
    enabled: true,
  },
  packageRules: [
    {
      description: "Group Terraform GitHub provider updates together",
      matchDatasources: ["terraform-provider"],
      matchPackageNames: ["integrations/github"],
      groupName: "integrations/github",
    }
  ],
}
